        <mxCell id="t_web" value="web (Tavily)&#10;• Tavily search → links + page content&#10;• Synthesize answer (LLM)&#10;• Hallucination Checker verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacingLeft=10" vertex="1" parent="1">
