        <mxCell id="te_t" value="template" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="t_route" target="t_tmpl"><mxGeometry relative="1" as="geometry" /></mxCell>
