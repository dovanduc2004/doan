  <diagram id="memory" name="5-Finalization-Memory">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="m_title" value="Finalization &amp; Conversation Memory" style="text;html=1;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="230" y="10" width="440" height="30" as="geometry" />
        </mxCell>

        <mxCell id="m_final" value="SSE 'final' event&#10;answer + references → rendered on the Web UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="290" y="60" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m_bg" value="Background task (after streaming completes)&#10;• Save session / messages / references&#10;• Update rolling session summary&#10;• Extract &amp; save user facts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="290" y="160" width="320" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m_short" value="Short-term memory&#10;last 5 turns verbatim&#10;+ rolling summary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="120" y="330" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="m_long" value="Long-term memory&#10;stable user facts&#10;(name, occupation, topics…)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="560" y="330" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="m_sqlite" value="SQLite — chat_history.db&#10;Chat_Sessions · Chat_Messages&#10;Chat_References · User_Facts" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="330" y="470" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="m_loop" value="Reused by Memory.build_context on the next turn (Fig. 2)" style="text;html=1;align=center;fontSize=13;fontStyle=2;fontColor=#9673a6" vertex="1" parent="1">
          <mxGeometry x="230" y="620" width="440" height="20" as="geometry" />
        </mxCell>

        <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="m_final" target="m_bg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="m_bg" target="m_short"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="m_bg" target="m_long"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me4" value="write" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="m_short" target="m_sqlite"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me5" value="write" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="m_long" target="m_sqlite"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;" edge="1" parent="1" source="m_sqlite" target="m_loop"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

