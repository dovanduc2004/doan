  <!-- ============================================================= -->
  <!-- PAGE 3 — INTERNAL LEGAL RAG PIPELINE                           -->
  <!-- ============================================================= -->
  <diagram id="rag-pipeline" name="3-Legal-RAG-Pipeline">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p_title" value="Internal Legal RAG Pipeline (tool = rag)" style="text;html=1;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="230" y="10" width="460" height="30" as="geometry" />
        </mxCell>

        <mxCell id="p_in" value="From Planner: rewritten_query + entities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="320" height="45" as="geometry" />
        </mxCell>

        <mxCell id="p_retrieve" value="① Retrieve &amp; Rerank&#10;• Generate 3 query variants (multi-query)&#10;• Vietnamese tokenize (PyVi ViTokenizer)&#10;• Qdrant search + metadata filter&#10;• RRF fusion → up to 50 documents&#10;• Cross-Encoder rerank → top 5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;spacingLeft=10" vertex="1" parent="1">
          <mxGeometry x="280" y="145" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p_qdrant" value="Qdrant&#10;(Domain_Law)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="p_extract" value="② BERT Extract&#10;extract the relevant snippet from each document" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="280" y="325" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p_grade" value="③ Grader Agent (CRAG)&#10;→ relevance_score (0–1), decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="425" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p_gcheck" value="score ≥ 0.6&#10;or sufficient?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="370" y="525" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_wf" value="best &lt; 0.4&#10;&amp; Web on?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="370" y="655" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_gen" value="④ Generator (Claude Sonnet 4.5)&#10;input: full article text + BERT highlight&#10;→ answer + references (cited documents)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="785" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p_hallu" value="⑤ Hallucination Checker&#10;→ is_grounded, confidence, unsupported_claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="905" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p_hcheck" value="Grounded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="370" y="1005" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_final" value="→ SSE 'final' event (Fig. 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="1140" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p_web" value="→ Web search fallback (Fig. 4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="660" y="670" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="pe0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p_in" target="p_retrieve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe_q" value="semantic search" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;startArrow=open;dashed=1;" edge="1" parent="1" source="p_qdrant" target="p_retrieve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p_retrieve" target="p_extract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p_extract" target="p_grade"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p_grade" target="p_gcheck"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe_retry" value="No → rewrite query &amp; retry (≤ 2, keep best)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="p_gcheck" target="p_retrieve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="570" /><mxPoint x="730" y="215" /></Array></mxGeometry></mxCell>
        <mxCell id="pe4" value="Yes / max iters" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p_gcheck" target="p_wf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe_wfy" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontColor=#b85450;" edge="1" parent="1" source="p_wf" target="p_web"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe_wfn" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p_wf" target="p_gen"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p_gen" target="p_hallu"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p_hallu" target="p_hcheck"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe_regen" value="No (conf ≥ 0.75 &amp; ≥ 2 bad claims)&#10;→ regenerate with feedback" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="p_hcheck" target="p_gen"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="1050" /><mxPoint x="160" y="825" /></Array></mxGeometry></mxCell>
        <mxCell id="pe_ok" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontStyle=1;" edge="1" parent="1" source="p_hcheck" target="p_final"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

