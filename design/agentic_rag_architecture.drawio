        <mxCell id="t_final" value="SSE 'final' event → answer + references (Fig. 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="500" width="340" height="50" as="geometry" />
