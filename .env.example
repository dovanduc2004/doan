# --- LLM provider: "bedrock" (recommended) or "gemini" ---
LLM_PROVIDER="bedrock"

# --- AWS Bedrock (primary LLM backend) ---
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"

# --- Google Gemini (legacy fallback; only used if LLM_PROVIDER=gemini) ---
APIS_GEMINI_LIST=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2
MODEL_GEMIMI="models/gemini-2.0-flash"

# --- Qdrant vector DB ---
URL_QDRANT_LOCAL="http://localhost:6333/"
EXIST_COLLECTION_NAME="Domain_Law"

# --- HuggingFace models (auto-downloaded on first run) ---
GENERATE_MODEL_EXTRACT="bhuy71/bert_extract_full_fine-tuned"
GENERATE_MODEL_TOKENIZER="bhuy71/bert_extract_full_fine-tuned"
MODEL_RERANK="bhuy71/rerank_model"
MODEL_EMBEDDING="bhuy71/embedding_finetuned"

# --- Cohere rerank (optional; fine-tuned reranker used by default) ---
MODEL_RERANKER="rerank-v3.5"
API_RERANKER=YOUR_COHERE_API_KEY_1,YOUR_COHERE_API_KEY_2

# --- Prompt templates ---
PATH_PROMPT="gemini_prompting.yaml"
PATH_INFOR="information.json"

# macOS / Apple Silicon (M1/M2/M3/M4): "mps". CPU-only: "cpu".
TORCH_DEVICE="mps"

# --- SQLite file path for chat history ---
DB_PATH="./source/data/chat_history.db"

# --- Tavily web search (Google Custom Search was closed to new customers in 2025) ---
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"
